{
  "mcpServers": {
    "web": {
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": { "UV_DEFAULT_INDEX": "https://pypi.tuna.tsinghua.edu.cn/simple" },
      "enabled": true
    },
    "ddg": {
      "transport": "stdio",
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "env": { "UV_DEFAULT_INDEX": "https://pypi.tuna.tsinghua.edu.cn/simple" },
      "enabled": true
    }
  }
}
